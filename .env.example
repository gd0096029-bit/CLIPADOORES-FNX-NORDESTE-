# ---------------------------------------------------------------
# Clipador Fênix — variáveis de ambiente
# Copie para .env.local (local) ou cadastre na Vercel (produção).
# Sem nenhuma variável preenchida, o site roda em MODO DEMO.
# ---------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor (sincronização de views). NUNCA com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 (Google Cloud Console → Credenciais → Chave de API)
YOUTUBE_API_KEY=

# TikTok for Developers (Login Kit + Display API, escopos user.info.basic e video.list)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta for Developers (Instagram API com login do Instagram)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Protege a rota /api/cron/sync (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
